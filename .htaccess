RewriteEngine On
RewriteBase /mini-ecommerce-api/


RewriteCond %{REQUEST_METHOD} ^GET$
RewriteRule ^api/products/([0-9]+)/?$ api/products/index.php?id=$1 [QSA,L]


RewriteCond %{REQUEST_METHOD} ^(PUT|PATCH)$
RewriteRule ^api/products/([0-9]+)/?$ api/products/update.php?id=$1 [QSA,L]


RewriteCond %{REQUEST_METHOD} ^DELETE$
RewriteRule ^api/products/([0-9]+)/?$ api/products/delete.php?id=$1 [QSA,L]

RewriteRule ^api/admin/orders/([0-9]+)/status/?$ api/admin/update_orders_status.php?id=$1 [QSA,L]